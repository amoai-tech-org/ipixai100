# Copy to .env locally. Never commit real keys.
OPENAI_API_KEY=
COPILOTKIT_TELEMETRY_DISABLED=true

# Local Docker Supabase only (typically 127.0.0.1:54342). Hosts outside the
# local allowlist are rejected. Omit this and Planner chat stays in RAM.
MASTRA_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres
