# Copy to .env locally. Never commit real keys.
OPENAI_API_KEY=
COPILOTKIT_TELEMETRY_DISABLED=true

# Public Supabase Auth (browser-safe). Never put a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local Postgres only (opt-in). Hosts outside the allowlist are rejected.
# Copy the URI from `supabase status` after `supabase start` (CLI default is
# 127.0.0.1:54322). A local Docker publish on 54342 is also allowed.
# Omit this and Planner chat stays in RAM (LibSQL).
# MASTRA_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres

# Hosted preview/runtime (IPI-1124). Never set this locally unless you intend
# fail-closed Postgres (no LibSQL). Pair with a Dashboard URI for fashionos
# only: user hyperdrive_mastra_runtime (or user.project-ref on the pooler).
# Prefer transaction pooler port 6543; session 5432 only if transaction fails.
# IPIX_MASTRA_HOSTED=1
# MASTRA_DATABASE_URL=postgresql://hyperdrive_mastra_runtime.[PROJECT_REF]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
